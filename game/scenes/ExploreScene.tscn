[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/ExploreScene.gd" id="1"]

[node name="ExploreScene" type="Node2D"]
script = ExtResource("1")

; ── Floor background (renders behind all Node2D content) ────────────────────
[node name="FloorBG" type="CanvasLayer" parent="."]
layer = -1

[node name="FloorRect" type="ColorRect" parent="FloorBG"]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.11, 0.20, 0.09, 1.0)

; ── World objects (walls, pickups, stone — populated by GDScript) ────────────
[node name="Objects" type="Node2D" parent="."]

; ── UI overlay ───────────────────────────────────────────────────────────────
[node name="UI" type="CanvasLayer" parent="."]
layer = 10

; Top bar background
[node name="TopBarBG" type="ColorRect" parent="UI"]
anchor_right = 1.0
custom_minimum_size = Vector2(0, 56)
color = Color(0.04, 0.07, 0.04, 0.92)

; Area name — top-left
[node name="AreaLabel" type="Label" parent="UI"]
position = Vector2(12, 16)
text = "Whispering Grove"
theme_override_font_sizes/font_size = 16
theme_override_colors/font_color = Color(0.68, 0.88, 0.55, 1.0)

; Creature name + level — centre-right of top bar
[node name="CreatureLabel" type="Label" parent="UI"]
position = Vector2(680, 8)
text = "— — —"
theme_override_font_sizes/font_size = 15
theme_override_colors/font_color = Color(0.88, 0.96, 0.75, 1.0)

; "EXP" prefix label
[node name="ExpLabel" type="Label" parent="UI"]
