text = "Slot locked\nReach Teen to unlock"
horizontal_alignment = 1
vertical_alignment = 1
visible = false
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.50, 0.50, 0.50, 0.70)

; ── Active bonuses strip ──────────────────────────────────────────────────────
[node name="BonusLabel" type="Label" parent="UI/EquipPanel/VBox"]
horizontal_alignment = 1
text = "Active bonuses: \u2014"
theme_override_font_sizes/font_size = 13
theme_override_colors/font_color = Color(0.92, 0.80, 0.38, 1.0)

[node name="CloseHint" type="Label" parent="UI/EquipPanel/VBox"]
horizontal_alignment = 1
text = "[ Q ] close"
theme_override_font_sizes/font_size = 12
theme_override_colors/font_color = Color(0.50, 0.65, 0.42, 0.80)

; ── Milestone completion popup ────────────────────────────────────────────────
[node name="MilestonePopup" type="PanelContainer" parent="UI"]
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -300.0
offset_top = -100.0
offset_right = 300.0
offset_bottom = 100.0
visible = false

[node name="VBox" type="VBoxContainer" parent="UI/MilestonePopup"]
theme_override_constants/separation = 12

[node name="PopupTitle" type="Label" parent="UI/MilestonePopup/VBox"]
text = ""
horizontal_alignment = 1
theme_override_font_sizes/font_size = 22
theme_override_colors/font_color = Color(0.95, 0.92, 0.60, 1.0)

[node name="PopupBody" type="Label" parent="UI/MilestonePopup/VBox"]
text = ""
horizontal_alignment = 1
autowrap_mode = 3
custom_minimum_size = Vector2(560, 0)
theme_override_font_sizes/font_size = 15
theme_override_colors/font_color = Color(0.85, 0.92, 0.72, 1.0)

[node name="PopupHint" type="Label" parent="UI/MilestonePopup/VBox"]
text = "[ SPACE ] continue"
horizontal_alignment = 1
