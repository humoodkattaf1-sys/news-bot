[gd_scene load_steps=2 format=3]

[ext_resource type="Script" path="res://scenes/CharacterSelectScene.gd" id="1"]

[node name="CharacterSelectScene" type="Control"]
anchor_right = 1.0
anchor_bottom = 1.0
script = ExtResource("1")

[node name="BG" type="ColorRect" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.07, 0.11, 0.07, 1)

[node name="Center" type="CenterContainer" parent="."]
anchor_right = 1.0
anchor_bottom = 1.0

[node name="VBox" type="VBoxContainer" parent="Center"]
theme_override_constants/separation = 20

[node name="Title" type="Label" parent="Center/VBox"]
text = "Who are you?"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 46
theme_override_colors/font_color = Color(0.75, 0.95, 0.65, 1)

[node name="Subtitle" type="Label" parent="Center/VBox"]
text = "Choose your protagonist"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 16
theme_override_colors/font_color = Color(0.58, 0.75, 0.52, 1)

[node name="Spacer1" type="Control" parent="Center/VBox"]
custom_minimum_size = Vector2(0, 16)

[node name="GenderRow" type="HBoxContainer" parent="Center/VBox"]
alignment = 1
size_flags_horizontal = 4

[node name="BoyBtn" type="Button" parent="Center/VBox/GenderRow"]
text = "Boy"
custom_minimum_size = Vector2(160, 90)
toggle_mode = true
button_pressed = true

[node name="GenderGap" type="Control" parent="Center/VBox/GenderRow"]
custom_minimum_size = Vector2(24, 0)

[node name="GirlBtn" type="Button" parent="Center/VBox/GenderRow"]
text = "Girl"
custom_minimum_size = Vector2(160, 90)
toggle_mode = true

[node name="Spacer2" type="Control" parent="Center/VBox"]
custom_minimum_size = Vector2(0, 8)

[node name="NameLabel" type="Label" parent="Center/VBox"]
text = "Enter your name:"
horizontal_alignment = 1
theme_override_font_sizes/font_size = 18
theme_override_colors/font_color = Color(0.72, 0.88, 0.62, 1)

[node name="NameInput" type="LineEdit" parent="Center/VBox"]
placeholder_text = "Traveller..."
max_length = 20
custom_minimum_size = Vector2(320, 50)
size_flags_horizontal = 4

[node name="Spacer3" type="Control" parent="Center/VBox"]
custom_minimum_size = Vector2(0, 16)

[node name="ConfirmBtn" type="Button" parent="Center/VBox"]
text = "Begin  →"
custom_minimum_size = Vector2(280, 58)
size_flags_horizontal = 4

[connection signal="pressed" from="Center/VBox/GenderRow/BoyBtn" to="." method="_on_boy_pressed"]
[connection signal="pressed" from="Center/VBox/GenderRow/GirlBtn" to="." method="_on_girl_pressed"]
[connection signal="pressed" from="Center/VBox/ConfirmBtn" to="." method="_on_confirm_pressed"]
