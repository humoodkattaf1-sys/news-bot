# ============================================================
# Hawalli Sheets Command Agent - Environment Variables
# ============================================================
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# Server
PORT=3000

# Google Sheets - Spreadsheet ID (from the URL)
# Example: https://docs.google.com/spreadsheets/d/THIS_IS_THE_ID/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# Google Service Account credentials
GOOGLE_CLIENT_EMAIL=your-service-account@your-project.iam.gserviceaccount.com
GOOGLE_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nYOUR_KEY_HERE\n-----END RSA PRIVATE KEY-----"

# Admin security token - generate a strong random string
# Example: openssl rand -hex 32
ADMIN_TOKEN=change_this_to_a_strong_secret_token

# Approval mode: true = require approval for sensitive operations
APPROVAL_MODE=true

# Timezone
TIMEZONE=Asia/Kuwait
